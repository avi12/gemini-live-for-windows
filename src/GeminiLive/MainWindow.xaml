<Window x:Class="GeminiLive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GeminiLive"
        Title="Gemini Live" WindowStyle="None" AllowsTransparency="True" ResizeMode="NoResize"
        SizeToContent="Height" Width="476" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        Background="Transparent" FontFamily="{StaticResource LiveFont}"
        Foreground="{DynamicResource LiveTextBrush}">

    <!-- Googlebook's Live: a caption card floating over a pill docked above the taskbar, with
         Gemini's glow along the pill's bottom edge. The margin leaves room for the glow's blur.
         Status, share label, mic glyph and their tooltips are set from code on construction. -->
    <StackPanel x:Name="Root" Margin="8,8,8,8" RenderTransformOrigin="0.5,1" MouseLeftButtonDown="OnDrag">

        <!-- Caption card: the running "You: / Gemini:" transcript, links Gemini mentioned, setup.
             HeightTransition glides the card to each new height instead of jumping. -->
        <Border x:Name="CaptionCard" Style="{StaticResource LiveCard}" Margin="0,0,0,10" Visibility="Collapsed">
            <local:HeightTransition>
                <StackPanel>
                    <!-- One TextBlock per line (CaptionPresenter), so each new line can fade in. -->
                    <ScrollViewer x:Name="TranscriptScroll" MaxHeight="176" VerticalScrollBarVisibility="Hidden">
                        <StackPanel x:Name="Transcript" />
                    </ScrollViewer>

                    <WrapPanel x:Name="LinkTray" Visibility="Collapsed" />

                    <!-- Google engine, first run only: one click to hand the browser our extension. -->
                    <StackPanel x:Name="ConnectPanel" Visibility="Collapsed" Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource LiveSupportingText}" TextWrapping="Wrap" Margin="0,0,0,10">
                            Gemini Live uses the Google account you're signed in to in your browser, through a small companion extension.
                        </TextBlock>
                        <Button Content="Add the browser extension" Click="OnConnect" HorizontalAlignment="Left"
                                Style="{StaticResource LiveAccentButton}" />
                        <TextBlock x:Name="ConnectSteps" Style="{StaticResource LiveCaptionText}" Visibility="Collapsed"
                                   Margin="0,10,0,0" Foreground="{DynamicResource LiveSecondaryTextBrush}">
                            In the extensions page that opened: turn on Developer mode, click Load unpacked, and paste the
                            folder path (it's on your clipboard). Gemini Live continues by itself.
                        </TextBlock>
                    </StackPanel>

                    <!-- API-key engine, first run only. -->
                    <StackPanel x:Name="KeyPanel" Visibility="Collapsed" Margin="0,4,0,0">
                        <TextBlock Style="{StaticResource LiveSupportingText}" TextWrapping="Wrap">
                            Paste a Gemini API key (free at
                            <Hyperlink NavigateUri="https://aistudio.google.com/apikey" RequestNavigate="OnLink">aistudio.google.com/apikey</Hyperlink>),
                            then press Enter.
                        </TextBlock>
                        <PasswordBox x:Name="KeyBox" Margin="0,8,0,0" KeyDown="OnKeyBoxKeyDown" />
                    </StackPanel>
                </StackPanel>
            </local:HeightTransition>
        </Border>

        <!-- The pill. -->
        <Grid Height="64">
            <!-- Gemini's glow: blurred, bleeding out under the pill's bottom edge. GlowAnimator
                 paints it (a drifting copy of LiveGlowBrush) and drives its strength. The
                 wrapper's opacity is the theme's peak, so those animations stay theme-agnostic. -->
            <Grid Opacity="{DynamicResource LiveGlowOpacity}">
                <Border x:Name="Glow" CornerRadius="{StaticResource PillRadius}" Margin="24,30,24,-6" Opacity="0.75">
                    <Border.Effect>
                        <BlurEffect Radius="22" />
                    </Border.Effect>
                </Border>
            </Grid>

            <Border Style="{StaticResource LivePill}">
                <Grid Margin="10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Share: which display Gemini sees. -->
                    <Button x:Name="ShareButton" Grid.Column="0" Style="{StaticResource LiveShareButton}" Click="OnShare">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource LiveIcon}" Text="{x:Static local:Glyphs.Display}" FontSize="16" />
                            <TextBlock x:Name="ShareLabel" Style="{StaticResource LiveStrongLabelText}" Margin="6,0,0,0"
                                       VerticalAlignment="Center" />
                            <TextBlock x:Name="ShareChevron" Style="{StaticResource LiveIcon}" Text="{x:Static local:Glyphs.ChevronDown}"
                                       FontSize="10" Margin="6,1,0,0" />
                        </StackPanel>
                    </Button>

                    <!-- Mic: mute/unmute. -->
                    <Button x:Name="MicButton" Grid.Column="1" Style="{StaticResource LiveRoundButton}" Margin="8,0,0,0"
                            Click="OnMute">
                        <TextBlock x:Name="MicGlyph" Style="{StaticResource LiveIcon}" FontSize="16"
                                   RenderTransformOrigin="0.5,0.5" />
                    </Button>

                    <TextBlock x:Name="StatusText" Grid.Column="2" Style="{StaticResource LiveSupportingText}" Margin="14,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                    <Button x:Name="SettingsButton" Grid.Column="3" Style="{StaticResource LiveRoundButton}"
                            Click="OnSettings" ToolTip="Settings">
                        <TextBlock Style="{StaticResource LiveIcon}" Text="{x:Static local:Glyphs.Gear}" FontSize="15" />
                    </Button>

                    <Button Grid.Column="4" Style="{StaticResource LiveRoundButton}" Margin="8,0,0,0"
                            Click="OnEnd" ToolTip="End (Win+C)">
                        <TextBlock Style="{StaticResource LiveIcon}" Text="{x:Static local:Glyphs.Close}" FontSize="15" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </StackPanel>
</Window>
