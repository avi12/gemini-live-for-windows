{
  "name": "@gemini-live/pill",
  "version": "0.1.0",
  "private": true,
  "description": "The Gemini Live pill: a Svelte window on winui-svelte, run as a sidecar of the C# app.",
  "license": "Apache-2.0",
  "author": "Avi (https://avi12.com)",
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./theme.css": "./src/ui/theme.css",
    "./dev-modules": "./dev/dev-modules.ts",
    "./relay": "./src/lib/relay.ts",
    "./mount": {
      "types": "./mount.d.ts",
      "default": "./src/mount.ts"
    }
  },
  "scripts": {
    "dev": "node dev/main.ts",
    "svelte:check": "svelte-check --tsconfig ./tsconfig.json",
    "build": "pnpm svelte:check && node --import ../scripts/scripts-alias.ts build.ts",
    "compile": "tsrs --noEmit"
  },
  "dependencies": {
    "@gemini-live/protocol": "workspace:*",
    "@microsoft/dynwinrt": "0.1.0-preview.23",
    "svelte": "5.59.1",
    "winui-svelte": "^0.0.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "postcss-html": "^1.8.1",
    "stylelint": "^17.16.0",
    "stylelint-config-ccb": "^3.32.0",
    "svelte-check": "^4.7.8",
    "tsrs": "7.1.0-beta.tsrs4",
    "vite": "8.3.8"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.13.1"
}
