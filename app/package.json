{
  "name": "@gemini-live/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gemini Live for Windows: the whole app in TypeScript on winui-svelte.",
  "license": "Apache-2.0",
  "author": "Avi (https://avi12.com)",
  "sideEffects": false,
  "scripts": {
    "svelte:check": "svelte-check --tsconfig ./tsconfig.json",
