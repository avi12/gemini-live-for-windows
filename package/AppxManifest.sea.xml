<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  IgnorableNamespaces="uap uap3 rescap desktop desktop6">

  <!-- Publisher must equal the signing certificate's subject (scripts\install.ps1 creates it). -->
  <Identity Name="Avi.GeminiLiveForWindows" Publisher="CN=GeminiLiveForWindows" Version="0.1.0.0" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Gemini Live</DisplayName>
    <PublisherDisplayName>Avi</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- HKCU writes reach the real registry, so the browsers see the native messaging host the app
         registers there (Glic\Link\NativeHost.cs). Needs the unvirtualizedResources capability. -->
    <desktop6:RegistryWriteVirtualization>disabled</desktop6:RegistryWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22631.0" MaxVersionTested="10.0.26300.0" />
    <!-- The pill's WinUI runs on the Windows App SDK 2.x framework package; a newer 2.x satisfies
         MinVersion. A sideload doesn't fetch it, so scripts\Install-WindowsAppRuntime.ps1 installs
         it from the values written here. -->
    <PackageDependency Name="Microsoft.WindowsAppRuntime.2" MinVersion="2.2.0.0"
      Publisher="CN=Microsoft Corporation, O=Microsoft Corporation, L=Redmond, S=Washington, C=US" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="GeminiLive" Executable="GeminiLive.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Gemini Live" Description="Talk to Gemini while it sees your screen"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />

      <Extensions>
        <!-- How Windows launches us on Win+C / the Copilot key. Parameters hands the URI to the exe as
             its first argument (process.argv[2]); a bare uap:Protocol passes nothing to a Node exe. -->
        <uap3:Extension Category="windows.protocol" Executable="GeminiLive.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:Protocol Name="geminilive-key" Parameters="&quot;%1&quot;">
            <uap:DisplayName>Gemini Live key</uap:DisplayName>
          </uap3:Protocol>
        </uap3:Extension>

        <!-- Puts "Gemini Live" in Settings > Personalization > Text input > Copilot key.
             MessageWParam values and ?state= names mirror the KeyTrigger enum in CopilotKey.cs. -->
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.windows.copilotkeyprovider"
            Id="GeminiLive"
            DisplayName="Gemini Live"
            Description="Talk to Gemini while it sees your screen"
            PublicFolder="Public">
            <uap3:Properties>
              <SingleTap MessageWParam="0">geminilive-key://?state=Tap</SingleTap>
              <PressAndHoldStart MessageWParam="1">geminilive-key://?state=HoldStart</PressAndHoldStart>
              <PressAndHoldStop MessageWParam="2">geminilive-key://?state=HoldStop</PressAndHoldStop>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>

        <!-- Starts the app quietly at sign-in, so the Circle to Search key (CircleKey.cs), a plain
             hotkey only a running process can hold, works before Win+C was ever pressed. -->
        <desktop:Extension Category="windows.startupTask" Executable="GeminiLive.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="GeminiLiveAtSignIn" Enabled="true" DisplayName="Gemini Live" />
        </desktop:Extension>
      </Extensions>
    </Application>

    <!-- The browsers' native messaging host: the same SEA exe in host mode (it sees chrome-extension://
         as its first argument). A browser can't start an exe inside the package folder, so it starts
         the execution alias in WindowsApps. scripts\install.ps1 -HostExe Copy (default) ships
         GeminiLiveHost.exe as a second copy of the exe; -HostExe Shared points this application and its
         alias at GeminiLive.exe instead (untested: two applications on one executable). -->
    <Application Id="NativeHost" Executable="GeminiLiveHost.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="Gemini Live native host" Description="Tells the Gemini Live extension where the app listens"
        BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />

      <Extensions>
        <uap3:Extension Category="windows.appExecutionAlias" Executable="GeminiLiveHost.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="GeminiLiveHost.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Extensions>
    <!-- The SEA app activates WebView2's WinRT classes by name (an environment per Google page). A
         package's own catalogue lists only the framework package's classes, so the DLL beside the
         bundle (app\dist\bin\x64, from winui-svelte's build) is registered here. -->
    <Extension Category="windows.activatableClass.inProcessServer">
      <InProcessServer>
        <Path>bin\x64\Microsoft.Web.WebView2.Core.dll</Path>
        <ActivatableClass ActivatableClassId="Microsoft.Web.WebView2.Core.CoreWebView2Environment" ThreadingModel="both" />
        <ActivatableClass ActivatableClassId="Microsoft.Web.WebView2.Core.CoreWebView2EnvironmentOptions" ThreadingModel="both" />
        <ActivatableClass ActivatableClassId="Microsoft.Web.WebView2.Core.CoreWebView2CustomSchemeRegistration" ThreadingModel="both" />
      </InProcessServer>
    </Extension>
  </Extensions>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
    <DeviceCapability Name="microphone" />
    <DeviceCapability Name="webcam" />
  </Capabilities>
</Package>
