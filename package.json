{
  "name": "gemini-live-windows",
  "private": true,
  "description": "Workspace root: the page bridges, the companion extension and the messaging they share, linted as one.",
  "license": "Apache-2.0",
  "author": "Avi (https://avi12.com)",
  "repository": "github:avi12/gemini-live-for-windows",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @gemini-live/pill dev",
    "prepare": "simple-git-hooks",
    "lint": "avi12-lint",
    "svelte:check": "pnpm --filter @gemini-live/pill svelte:check && pnpm --filter @gemini-live/app svelte:check",
    "fallow": "fallow audit --base HEAD",
    "dev:lint": "pnpm fallow && pnpm lint && pnpm svelte:check && pnpm test",
    "test": "pnpm --filter @gemini-live/app --filter @gemini-live/protocol test",
    "lint:fix": "avi12-lint --fix"
  },
  "devDependencies": {
    "avi12-lint": "github:avi12/lint-config#v0.4.9&path:/packages/avi12-lint",
    "eslint": "^10.13.0",
    "eslint-config-avi12": "github:avi12/lint-config#v0.4.9&path:/packages/eslint-config",
    "eslint-plugin-svelte": "^3.24.0",
    "fallow": "2.103.0",
    "fallow-config-avi12": "github:avi12/lint-config#v0.4.9&path:/packages/fallow-config",
    "oxfmt": "^0.78.0",
    "oxfmt-config-avi12": "github:avi12/lint-config#v0.4.9&path:/packages/oxfmt-config",
    "oxlint": "1.90.0",
    "oxlint-config-avi12": "github:avi12/lint-config#v0.4.9&path:/packages/oxlint-config",
    "oxlint-plugin-naming": "github:avi12/lint-config#v0.4.9&path:/packages/oxlint-plugin-naming",
    "postcss-html": "^1.8.1",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^17.16.0",
    "stylelint-config-avi12": "github:avi12/lint-config#v0.4.9&path:/packages/stylelint-config",
    "stylelint-config-standard": "^40.0.0",
    "svelte": "5.57.3",
    "svelte-eslint-parser": "^1.10.1",
    "typescript": "^5.9.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm avi12-lint --staged"
  },
  "packageManager": "pnpm@11.13.1"
}
