{
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "none",
  "bracketSpacing": true,
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "sortImports": { "sortSideEffects": true },
  "ignorePatterns": [
    "**/dist/**",
    "**/.output/**",
    "**/.wxt/**",
    "**/bin/**",
    "**/obj/**",
    "**/*.ps1",
    "bridge/dist/**"
  ]
}
