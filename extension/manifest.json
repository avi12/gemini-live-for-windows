{
  "manifest_version": 3,
  "name": "Gemini Live for Windows - Google session",
  "version": "1.0.0",
  "description": "Keeps the Gemini Live desktop app signed in with this browser's Google session, and fresh as Google rotates it.",
  "key": "",
  "permissions": [
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "https://*.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}