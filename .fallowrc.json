{
  "$schema": "https://raw.githubusercontent.com/getfallow/fallow/main/schema/fallowrc.json",
  "extends": ["./node_modules/fallow-config-avi12/fallow.json"],
  "entry": [
    "bridge/glic/glic_bridge.ts",
    "bridge/home/home_bridge.ts",
    "bridge/build.mjs",
    "extension/scripts/pack-crx.mjs",
    "extension/src/entrypoints/**",
    "extension/wxt.config.ts",
    "messaging/src/index.ts",
    "pill/src/main.ts",
    "pill/src/window.ts",
    "pill/build.ts",
    "pill/dev/main.ts",
    "pill/dev/window.ts",
    "pill/dev/attach.ts",
    "pill/dev/dev-mount.ts",
    "pill/dev/fake-capture-bridge.ts",
    "pill/dev/module-server-worker.ts",
    "pill/vite.config.ts",
    "pill/svelte.config.js",
    "app/src/main.ts",
    "app/src/window.ts",
    "app/src/host.ts",
    "app/src/media/audio/audio-worker.ts",
    "app/src/media/screen-text/uia-worker.ts",
    "app/src/overlays/worker.ts",
    "app/src/*/index.ts",
    "app/src/**/*.test.ts",
    "app/build.ts",
    "app/test-alias.ts",
    "scripts/build-winui-app.ts",
    "scripts/sea/*.ts",
    "scripts/sea/selftest/*.js",
    "app/vite.config.ts",
    "app/svelte.config.js",
    "protocol/src/view.ts",
    "protocol/src/link.ts",
    "protocol/src/pill-dev.ts"
  ],
  "ignorePatterns": [".claude/worktrees/**", "bridge/dist/*.js", "pill/dist/**", "app/dist/**"],
  "ignoreDependencies": [
    "postcss-html",
    "avi12-lint",
    "eslint-config-avi12",
    "fallow-config-avi12",
    "oxlint-config-avi12",
    "oxlint-plugin-naming",
    "stylelint-config-avi12",
    "oxfmt-config-avi12"
  ],
  "health": {
    "maxCognitive": 30,
    "maxCrap": 10000
  },
  "rules": {
    "unused-enum-members": "warn"
  },
  "overrides": [
    {
      "files": ["extension/scripts/pack-crx.mjs"],
      "rules": {
        "unresolved-imports": "off"
      }
    }
  ]
}
