{
  "name": "gemini-live-session",
  "version": "1.0.0",
  "type": "module",
  "description": "Companion extension that hands the browser's Google session to the Gemini Live desktop app",
  "private": true,
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@gemini-live/messaging": "link:../messaging"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "typescript": "^5.7.0",
    "wxt": "^0.20.27"
  },
  "packageManager": "pnpm@11.13.1"
}
