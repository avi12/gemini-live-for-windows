{
  "name": "gemini-live-windows",
  "private": true,
  "description": "Workspace root: the page bridges, the companion extension and the messaging they share, linted as one.",
  "license": "Apache-2.0",
  "author": "Avi (https://avi12.com)",
  "repository": "github:avi12/gemini-live-for-windows",
  "workspaces": [
    "bridge",
    "extension",
    "messaging",
    "pill",
    "protocol",
    "app"
  ],
  "type": "module",
  "imports": {
    "#app/*": "./app/*"
  },
  "scripts": {
    "dev": "bun run --filter @gemini-live/pill dev",
    "prepare": "simple-git-hooks",
    "lint": "avi12-lint",
    "svelte:check": "bun run --filter @gemini-live/pill svelte:check && bun run --filter @gemini-live/app svelte:check",
    "fallow": "fallow audit --base HEAD",
    "dev:lint": "bun run fallow && bun run lint && bun run compile && bun run svelte:check && bun run test",
    "test": "bun run --filter @gemini-live/app --filter @gemini-live/protocol test",
    "lint:fix": "avi12-lint --fix",
    "compile": "bun run --filter '*' --if-present compile"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "3.24.1",
    "fallow": "3.46.0",
    "globals": "^17.13.0",
    "lint-config": "github:avi12/lint-config#v0.13.0",
    "oxfmt": "^0.79.0",
    "oxlint": "1.94.0",
    "postcss-html": "^1.8.1",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^17.16.0",
    "stylelint-config-ccb": "^3.32.0",
    "stylelint-config-standard": "^40.0.0",
    "svelte": "5.57.3",
    "svelte-eslint-parser": "1.11.0",
    "tsrs": "7.1.0-beta.tsrs4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run avi12-lint --staged"
  },
  "packageManager": "bun@1.4.5",
  "trustedDependencies": [
    "esbuild",
    "fallow",
    "simple-git-hooks"
  ]
}
