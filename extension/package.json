{
  "name": "gemini-live-session",
  "version": "0.0.1",
  "type": "module",
  "description": "Companion extension that hands the browser's Google session to the Gemini Live desktop app",
  "license": "Apache-2.0",
  "author": "Avi (https://avi12.com)",
  "private": true,
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "pack:crx": "node scripts/pack-crx.mjs",
    "release": "wxt build && wxt zip && node scripts/pack-crx.mjs",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@gemini-live/messaging": "workspace:*"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "crx3": "^2.0.0",
    "typescript": "^5.7.0",
    "wxt": "^0.20.27"
  },
  "packageManager": "pnpm@11.13.1"
}
