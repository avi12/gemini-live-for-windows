<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>GeminiLive</AssemblyName>
    <RootNamespace>GeminiLive</RootNamespace>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- glic_bridge.js and home_bridge.js are GENERATED from bridge\*.ts (TypeScript, Zod for Home);
         BundleBridges below keeps them current, and scripts\install.ps1 does the authoritative build. -->
    <!-- The WPF SDK only finds App.xaml at the project root; ours lives in App\ with the rest of
         the startup code. -->
    <Page Remove="App\App.xaml" />
    <ApplicationDefinition Include="App\App.xaml" />
    <EmbeddedResource Include="Glic\Bridges\glic_bridge.js" LogicalName="GeminiLive.Glic.glic_bridge.js" />
    <EmbeddedResource Include="Glic\Bridges\home_bridge.js" LogicalName="GeminiLive.Glic.home_bridge.js" />
    <!-- The companion extension's WXT build ships with the app; ExtensionSetup copies it out for
         the browser. scripts\install.ps1 builds it first with pnpm. -->
    <Content Include="..\..\extension\.output\chrome-mv3\**\*" Link="extension\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Google Sans (OFL 1.1, Fonts\OFL.txt), from github.com/google/fonts ofl/googlesans v14.000.
         Embedded so App.xaml's LiveFont resolves even where Google Sans isn't installed. The
         variable font's named instances (Regular 400 / Medium 500 / Bold 700) render as real
         weights in .NET WPF; SemiBold resolves to Bold. -->
    <Resource Include="Fonts\GoogleSans-Variable.ttf" />
    <None Include="Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- Material Symbols Rounded (Apache-2.0, Fonts\MaterialSymbols-LICENSE.txt), from
         github.com/google/material-design-icons variablefont/ at 10ecc14, renamed without the
         [FILL,GRAD,opsz,wght] brackets. App.xaml's IconFont; WPF renders its default instance
         (outlined, weight 400). Glyphs.cs holds the code points. -->
    <Resource Include="Fonts\MaterialSymbolsRounded.ttf" />
    <None Include="Fonts\MaterialSymbols-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <!-- The repo's lint rules that Roslyn has no built-in for (see .editorconfig), and CA1502's
       complexity threshold. -->
  <ItemGroup>
    <ProjectReference Include="..\..\analyzers\GeminiLive.Analyzers\GeminiLive.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\analyzers\GeminiLive.Analyzers.CodeFixes\GeminiLive.Analyzers.CodeFixes.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="CodeMetricsConfig.txt" />
  </ItemGroup>

  <!-- The native messaging host (src\GeminiLiveHost) builds into this output too, since an
       unpackaged run registers the GeminiLiveHost.exe next to GeminiLive.exe (Glic\Link\NativeHost.cs).
       scripts\install.ps1 publishes it into the package layout separately. -->
  <ItemGroup>
    <ProjectReference Include="..\GeminiLiveHost\GeminiLiveHost.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyNativeHost" AfterTargets="Build">
    <MSBuild Projects="..\GeminiLiveHost\GeminiLiveHost.csproj" Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="NativeHostAssembly" />
    </MSBuild>
    <PropertyGroup>
      <NativeHostDir>@(NativeHostAssembly->'%(RootDir)%(Directory)')</NativeHostDir>
    </PropertyGroup>
    <ItemGroup>
      <NativeHostFile Include="$(NativeHostDir)GeminiLiveHost.*" />
    </ItemGroup>
    <Copy SourceFiles="@(NativeHostFile)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <!-- Rebuild the embedded page bridge from its TypeScript on every build. Skipped on a clean
       C#-only checkout where the bridge's deps aren't installed; scripts\install.ps1 runs the full
       type-checked bridge build. -->
  <Target Name="BundleBridges" BeforeTargets="BeforeBuild"
          Condition="Exists('$(MSBuildProjectDirectory)\..\..\bridge\node_modules')">
    <Exec Command="node build.mjs" WorkingDirectory="$(MSBuildProjectDirectory)\..\..\bridge" />
  </Target>

</Project>
