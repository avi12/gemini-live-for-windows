{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/oxlint-config-avi12/oxlint.json", "./node_modules/oxlint-plugin-naming/preset.json"],
  "overrides": [
    {
      "files": ["bridge/**/*.ts", "extension/src/**", "messaging/src/**"],
      "env": {
        "browser": true,
        "node": false,
        "webextensions": true
      },
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "process",
            "message": "browser code (page bridges, extension, messaging) does not run under Node - read config via import.meta.env, not process"
          },
          {
            "name": "Reflect",
            "message": "Do not use Reflect. Use direct property access instead."
          }
        ]
      }
    },
    {
      "files": ["extension/src/entrypoints/**"],
      "rules": {
        "no-restricted-exports": "off"
      }
    },
    {
      "files": ["messaging/src/index.ts"],
      "rules": {
        "house/positional-parameters": "off"
      }
    }
  ],
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.output/**",
    "**/.wxt/**",
    "**/bin/**",
    "**/obj/**",
    "pill/dist/**",
    "app/dist/**",
    "bridge/dist/**",
    ".claude/worktrees/**",
    "src/GeminiLive/Glic/Bridges/*.js"
  ],
  "rules": {
    "naming/convention": [
      "error",
      {
        "presets": ["webextension-manifest"],
        "allowedNames": [
          {
            "reason": "Gemini web app ships this key in its own settings blob",
            "names": ["default_BardChatUi"]
          }
        ]
      }
    ]
  }
}
